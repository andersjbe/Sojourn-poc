{
  "expo": {
    "name": "Sojourn",
    "slug": "sojourn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sojourn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sojourn.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sojourn tags your journal entries with where you were on the trail."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EBDD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sojourn.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EBDD",
          "dark": {
            "backgroundColor": "#171C18"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sojourn tags your journal entries with where you were on the trail."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sojourn attaches your trail photos to journal entries.",
          "cameraPermission": "Sojourn lets you take trail photos for your journal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
